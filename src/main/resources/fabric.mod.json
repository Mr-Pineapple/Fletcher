{
	"schemaVersion": 1,
	"id": "fletcher",
	"version": "${version}",
	"name": "Fletcher",
	"description": "A mod that adds functionality to the Fletching Table\n\nYou can now use the fletching table to craft tipped and spectral arrows as well as repair your bows and crossbows",
	"authors": [
		"Mr. Pineapple"
	],
	"contact": {
		"homepage": "https://discord.gg/mNWSEB5",
		"sources": "https://github.com/Mr-Pineapple/Fletcher",
		"issues": "https://github.com/Mr-Pineapple/Fletcher/issues"
	},
	"license": "CC0-1.0",
	"icon": "assets/fletcher/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.mrpineapple.fletcher.Fletcher"
		],
		"client": [
			"com.mrpineapple.fletcher.FletcherClient"
		],
		"rei_client": [
			"com.mrpineapple.fletcher.compat.rei.REIFletchingClientPlugin"
		],
		"rei_common": [
			"com.mrpineapple.fletcher.compat.rei.REIFletchingCommonPlugin"
		],
		"jei_mod_plugin": [
			"com.mrpineapple.fletcher.compat.jei.JEIFletchingPlugin"
		]
	},
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*"
	}
}